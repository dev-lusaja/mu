 68: // Custom, themed item tooltip (replaces the native browser title tooltip).
 69: const itemTooltip = document.getElementById('itemTooltip');
 70: 
 71: function buildTooltip(desc) {
 72:     const lines = desc.split('\n');
 73:     const head = `<div class="tip-head">${escapeHtml(lines[0])}</div>`;
 74:     const opts = lines.slice(1).map(line => {
 75:         let cls = 'tip-line';
 76:         if (line.startsWith('+ Exc')) cls += ' exc';
 77:         else if (line.startsWith('+ Skill')) cls += ' skill';
 78:         else if (line.includes('Socket')) cls += ' sock';
 79:         else cls += ' opt';
 80:         return `<div class="${cls}">${escapeHtml(line)}</div>`;
 81:     }).join('');
 82:     return head + opts;
 83: }
 84: 
 85: function moveTooltip(e) {
 86:     const pad = 16;
 87:     const rect = itemTooltip.getBoundingClientRect();
 88:     let x = e.clientX + pad;
 89:     let y = e.clientY + pad;
 90:     if (x + rect.width > window.innerWidth - 8) x = e.clientX - rect.width - pad;
 91:     if (y + rect.height > window.innerHeight - 8) y = window.innerHeight - rect.height - 8;
 92:     itemTooltip.style.left = Math.max(8, x) + 'px';
 93:     itemTooltip.style.top = Math.max(8, y) + 'px';
 94: }
 95: 
 96: document.addEventListener('mouseover', e => {
 97:     const slot = e.target.closest?.('.armory-slot.filled');
 98:     if (!slot || !slot.dataset.tip) return;
 99:     itemTooltip.innerHTML = buildTooltip(slot.dataset.tip);
100:     itemTooltip.style.display = 'block';
101:     moveTooltip(e);
102: });
103: document.addEventListener('mousemove', e => {
104:     if (itemTooltip.style.display === 'block' && e.target.closest?.('.armory-slot.filled')) moveTooltip(e);
105: });
106: document.addEventListener('mouseout', e => {
107:     if (e.target.closest?.('.armory-slot.filled')) itemTooltip.style.display = 'none';
108: });

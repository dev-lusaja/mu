135: async function loadCharacter(name) {
136:     const equip = document.getElementById('armoryEquip');
137:     const charInfo = document.getElementById('charInfo');
138:     const tr = t();
139:     equip.innerHTML = `<p class="armory-message">...</p>`;
140:     charInfo.innerHTML = '';
141: 
142:     try {
143:         const response = await fetch('/api/public/armory/' + encodeURIComponent(name));
144:         if (response.status === 404) {
145:             equip.innerHTML = `<p class="armory-message error">${tr.ARMORY_NOT_FOUND}</p>`;
146:             return;
147:         }
148:         if (!response.ok) {
149:             const err = await response.json().catch(() => ({}));
150:             equip.innerHTML = `<p class="armory-message error">${tr[err.code] || tr.rankingError}</p>`;
151:             return;
152:         }
153: 
154:         const data = await response.json();
155: 
156:         // Update character profile picture based on character class name/code
157:         const charImg = document.getElementById('charImage');
158:         if (charImg) {
159:             charImg.src = getProfileImageByClass(data.className);
160:             charImg.alt = data.className || 'Character';
161:         }
162: 
163:         charInfo.innerHTML = `
164:             <div class="armory-char-name">${escapeHtml(data.name)}</div>
165:             <div class="armory-char-class">${escapeHtml(data.className)}</div>
166:             <div class="armory-char-stats">
167:                 <span>${tr.charLvl}: <b>${data.level}</b></span>
168:                 <span>${tr.armoryResets}: <b>${data.resets}</b></span>
169:                 <span>ML: <b>${data.masterLevel}</b></span>
170:             </div>`;
171: 
172:         if (!data.items || data.items.length === 0) {
173:             renderEquip([]);
174:             equip.insertAdjacentHTML('afterbegin', `<p class="armory-message">${tr.armoryNoItems}</p>`);
175:             return;
176:         }
177:         renderEquip(data.items);
178:     } catch {
179:         equip.innerHTML = `<p class="armory-message error">${tr.rankingError}</p>`;
180:     }
181: }

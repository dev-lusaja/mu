130:     dl: {
131:         name: "Dark Lord",
132:         image: "/img/dl_profile.jpeg",
133:         desc: "Commanders of Valley of Loren. Leading armies with high Lord Leadership, Dark Lords summon the Dark Raven and Dark Horse to dominate the battlefield.",
134:         stats: [88, 85, 75]
135:     },
136:     sum: {
137:         name: "Summoner",
138:         image: "/img/sm_profile.jpeg",
139:         desc: "Wielders of ancient dark curses and mysterious summons. Summoners drain enemy vitality while casting debilitating spells upon opponents.",
140:         stats: [92, 50, 85]
141:     }
142: };
143: 
144: function selectCharClass(key, btnElem) {
145:     const data = charClassData[key];
146:     if (!data) return;
147: 
148:     document.querySelectorAll('.char-tab').forEach(b => b.classList.remove('active'));
149:     if (btnElem) btnElem.classList.add('active');
150: 
151:     document.getElementById('charClassName').innerText = data.name;
152:     document.getElementById('charClassDesc').innerText = data.desc;
153:     document.getElementById('statFill1').style.width = data.stats[0] + '%';
154:     document.getElementById('statFill2').style.width = data.stats[1] + '%';
155:     document.getElementById('statFill3').style.width = data.stats[2] + '%';
156: 
157:     const showcaseImg = document.getElementById('charShowcaseImg');
158:     if (showcaseImg && data.image) {
159:         showcaseImg.src = data.image;
160:         showcaseImg.alt = data.name;
161:     }
162: }
163: 
164: function renderDownloads() {
165:     const area = document.getElementById('downloadArea');
166:     if (!area) return;
167:     const t = window.t();
168:     const launcherUrl = window.muConfig && window.muConfig.launcherUrl;
169:     const items = (window.muConfig.downloads || []).map(d => {
170:         const isLauncher = d.id === 'launcher';
171:         const url = (isLauncher && launcherUrl) ? launcherUrl : d.url;
172:         const cls = d.recommended ? 'recommended' : (d.soon ? 'soon' : '');
173:         const tag = d.recommended ? `<span class="dlC-tag">${t.dlRecommended}</span>`
174:             : (d.soon ? `<span class="dlC-tag">${t.dlSoon}</span>` : '');
175:         const targetAttr = (!d.soon && (isLauncher || d.target === '_blank')) ? ' target="_blank" rel="noopener noreferrer"' : '';
176:         return `<a class="dlC-item ${cls}" href="${d.soon ? '#' : url}"${targetAttr}><div class="dlC-item-left"><span>${d.icon}</span> <span>${d.name}</span></div>${tag}</a>`;
177:     }).join('');
178: 
179:     area.innerHTML = `
180:         <div class="dlC-wrap" id="dlCWrap">
181:             <div class="dlC-trigger dl-gold" id="dlCTrigger">
182:                 <span>⬇ ${t.dlDownload}</span><span class="dlC-caret">▼</span>
183:             </div>
184:             <div class="dlC-menu">${items}</div>
185:         </div>`;
186: 
187:     document.getElementById('dlCTrigger').addEventListener('click', e => {
188:         e.stopPropagation();
189:         document.getElementById('dlCWrap').classList.toggle('open');
190:     });
191: }
192: 
193: document.addEventListener('click', () => {
194:     const wrap = document.getElementById('dlCWrap');
195:     if (wrap) wrap.classList.remove('open');
196: });
197: 
198: function updateServerClock() {
199:     const clock = document.getElementById('serverClock');
200:     if (!clock) return;
201:     try {
202:         const now = new Date();
203:         const options = {
204:             timeZone: 'America/Lima',
205:             hour: '2-digit',
206:             minute: '2-digit',
207:             second: '2-digit',
208:             hour12: true
209:         };
210:         clock.innerText = now.toLocaleTimeString('es-PE', options);
211:     } catch {
212:         const now = new Date();
213:         clock.innerText = now.toTimeString().split(' ')[0];
214:     }
215: }
216: 
217: updateServerClock();
218: setInterval(updateServerClock, 1000);
219: 
220: checkServerStatus();
221: checkOnlinePlayers();
222: loadWidgetRankings();
223: setInterval(checkServerStatus, 30000);
224: setInterval(checkOnlinePlayers, 30000);
</file>


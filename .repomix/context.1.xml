110: function renderEquip(items) {
111:     const equip = document.getElementById('armoryEquip');
112:     const bySlot = {};
113:     items.forEach(it => bySlot[it.slot] = it);
114: 
115:     const cells = SLOTS.map(def => {
116:         const item = bySlot[def.slot];
117:         const style = `grid-column:${def.col};grid-row:${def.row};`;
118:         if (!item) {
119:             return `<div class="armory-slot empty" style="${style}"><span class="slot-label">${def.label}</span></div>`;
120:         }
121:         const badges =
122:             (item.excellent ? '<span class="badge exc">EXC</span>' : '') +
123:             (item.ancient ? '<span class="badge anc">ANC</span>' : '') +
124:             (item.sockets > 0 ? `<span class="badge sock">${item.sockets}S</span>` : '');
125:         return `<div class="armory-slot filled" style="${style}" data-tip="${escapeHtml(item.description)}">
126:                     <img src="/img/items/${escapeHtml(item.image)}" alt="${escapeHtml(item.description)}"
127:                          onerror="this.classList.add('img-missing')">
128:                     ${badges}
129:                 </div>`;
130:     }).join('');
131: 
132:     equip.innerHTML = `<div class="armory-doll">${cells}</div>`;
133: }

@page "/stats"
@{
    ViewData["Title"] = "Top Rankings - Murio OpenMU";
    ViewData["BodyClass"] = "stats-body";
    ViewData["ActivePage"] = "/stats";
}

<div class="murio-subpage-container">
    <div class="section-header">
        <h2 class="section-title"><span class="icon">✦</span> <span data-i18n="rankingTitle">TOP RANKINGS</span> <span class="icon">✦</span></h2>
    </div>

    <div class="server-status" id="serverStatus">
        <span class="status-dot" id="statusDot"></span>
        <span id="statusText">Checking...</span>
    </div>

    <div class="murio-card ranking-card">
        <div class="card-tabs-bar">
            <button class="card-tab active"><span data-i18n="tabTopPlayers">TOP PLAYERS</span></button>
            <button class="card-tab mock-link" title="Guild Rankings (Preview)"><span data-i18n="tabTopGuilds">TOP GUILDS</span></button>
        </div>

        <div class="table-responsive">
            <table class="murio-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th data-i18n="charName">Character</th>
                        <th data-i18n="charClass">Class</th>
                        <th data-i18n="charLvl">Level</th>
                        <th>Resets</th>
                        <th data-i18n="charMl" class="master-level">Master Level</th>
                    </tr>
                </thead>
                <tbody id="rankingBody">
                    <tr>
                        <td colspan="6" class="table-loader">Loading heroes...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/stats.js"></script>
}

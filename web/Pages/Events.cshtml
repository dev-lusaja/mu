@page "/events"
@{
    ViewData["Title"] = "Events Schedule - Murio OpenMU";
    ViewData["BodyClass"] = "stats-body";
    ViewData["ActivePage"] = "/events";
}

<div class="murio-subpage-container">
    <div class="section-header">
        <h2 class="section-title"><span class="icon">✦</span> <span data-i18n="eventsTitle">UPCOMING EVENTS</span> <span class="icon">✦</span></h2>
    </div>

    <div class="server-status" id="serverStatus">
        <span class="status-dot" id="statusDot"></span>
        <span id="statusText">Checking...</span>
    </div>

    <div class="murio-card events-card">
        <div id="eventsContainer">
            <div class="event-loader" data-i18n="processing">Loading event schedule...</div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="/css/events.css">
}

@section Scripts {
    <script src="/js/events.js"></script>
}

# Backup Config (Postgres)
OPENMU_BACKUP_PATH=
BACKUP_CRON_SCHEDULE="0 3 * * *"   # Cada 24 horas a las 03:00 AM (sintaxis cron: minuto hora día mes día_semana)
BACKUP_RETENTION_DAYS=7            # Retener backups de los últimos N días
BACKUP_RUN_ON_STARTUP=true         # Realizar un backup al arrancar el contenedor


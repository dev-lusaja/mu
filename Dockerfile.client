# Stage 1: Build C++ Client to WebAssembly using Emscripten
FROM emscripten/emsdk:latest AS builder

WORKDIR /src

# Install build dependencies including OpenSSL, libcurl, pkg-config, and zlib
RUN apt-get update && apt-get install -y \
    git \
    cmake \
    build-essential \
    python3 \
    pkg-config \
    libssl-dev \
    libcurl4-openssl-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone MuMain repository and submodules
RUN git clone --recursive https://github.com/sven-n/MuMain.git mumain

WORKDIR /src/mumain

# Build script with WASM compilation
RUN emcmake cmake -B build-wasm \
    -DCMAKE_BUILD_TYPE=Release \
    -DENABLE_EDITOR=OFF \
    -DOPENSSL_ROOT_DIR=/usr \
    || true

RUN cmake --build build-wasm --target Main -j$(nproc) || true

# Stage 2: Serve WebAssembly assets via NGINX
FROM nginx:alpine

COPY ./nginx/default.conf /etc/nginx/conf.d/default.conf
COPY ./public /usr/share/nginx/html

# Copy compiled WASM and JS glue code if built, or create empty placeholders for volume mounting
COPY --from=builder /src/mumain/build-wasm/src/Main.js* /usr/share/nginx/html/client.js
COPY --from=builder /src/mumain/build-wasm/src/Main.wasm* /usr/share/nginx/html/client.wasm

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]

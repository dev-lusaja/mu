# Stage 1: Build C++ Client to WebAssembly using Emscripten
FROM emscripten/emsdk:latest AS builder

WORKDIR /src

# Install build dependencies including OpenSSL, libcurl, pkg-config, and zlib
RUN apt-get update && apt-get install -y \
    git \
    cmake \
    build-essential \
    python3 \
    pkg-config \
    libssl-dev \
    libcurl4-openssl-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone MuMain repository and submodules
RUN git clone --recursive https://github.com/sven-n/MuMain.git mumain

WORKDIR /src/mumain

# Build script with caching check: skip compilation if cached client.wasm exists
RUN bash -c '\
if [ -f /usr/share/nginx/html/client.wasm ] && [ -f /usr/share/nginx/html/client.js ]; then \
    echo "=== Found cached client.wasm & client.js. Skipping C++ compilation. ==="; \
    mkdir -p build-wasm/src; \
    cp /usr/share/nginx/html/client.js build-wasm/src/Main.js; \
    cp /usr/share/nginx/html/client.wasm build-wasm/src/Main.wasm; \
else \
    echo "=== Compiling MuMain C++ Client to WebAssembly ==="; \
    emcmake cmake -B build-wasm -DCMAKE_BUILD_TYPE=Release -DENABLE_EDITOR=OFF && \
    cmake --build build-wasm --target Main -j$(nproc); \
fi \
'

# Stage 2: Serve compiled WebAssembly assets via NGINX
FROM nginx:alpine

COPY ./nginx/default.conf /etc/nginx/conf.d/default.conf
COPY ./public /usr/share/nginx/html

# Copy compiled WASM and JS glue code from builder stage
COPY --from=builder /src/mumain/build-wasm/src/Main.js /usr/share/nginx/html/client.js
COPY --from=builder /src/mumain/build-wasm/src/Main.wasm /usr/share/nginx/html/client.wasm

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]

# Stage 1: Build C++ Client to WebAssembly using Emscripten
FROM emscripten/emsdk:latest AS builder

WORKDIR /src

# Install build dependencies
RUN apt-get update && apt-get install -y \
    git \
    cmake \
    build-essential \
    python3 \
    pkg-config \
    wget \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Build OpenSSL for WebAssembly (WASM static libraries)
WORKDIR /src/openssl
RUN wget https://github.com/openssl/openssl/releases/download/openssl-3.0.13/openssl-3.0.13.tar.gz && \
    tar -xzf openssl-3.0.13.tar.gz && \
    cd openssl-3.0.13 && \
    ./Configure linux-generic32 no-shared no-asm no-threads no-engine no-afalgeng --prefix=/opt/openssl-wasm CC=emcc AR=emar RANLIB=emranlib && \
    make -j$(nproc) && \
    make install_sw && \
    [ -d /opt/openssl-wasm/lib64 ] && [ ! -d /opt/openssl-wasm/lib ] && ln -s /opt/openssl-wasm/lib64 /opt/openssl-wasm/lib || true

# Build cURL for WebAssembly (WASM static libraries)
WORKDIR /src/curl
RUN wget https://curl.se/download/curl-8.6.0.tar.gz && \
    tar -xzf curl-8.6.0.tar.gz && \
    cd curl-8.6.0 && \
    emcmake cmake -B build-curl \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DCURL_DISABLE_LDAP=ON \
        -DCURL_DISABLE_LDAPS=ON \
        -DCURL_DISABLE_TELNET=ON \
        -DCURL_DISABLE_DICT=ON \
        -DCURL_DISABLE_FILE=ON \
        -DCURL_DISABLE_TFTP=ON \
        -DCMAKE_INSTALL_PREFIX=/opt/curl-wasm \
        -DOPENSSL_ROOT_DIR=/opt/openssl-wasm \
        -DOPENSSL_INCLUDE_DIR=/opt/openssl-wasm/include \
        -DOPENSSL_CRYPTO_LIBRARY=/opt/openssl-wasm/lib/libcrypto.a && \
    cmake --build build-curl --target install -j$(nproc) && \
    [ -d /opt/curl-wasm/lib64 ] && [ ! -d /opt/curl-wasm/lib ] && ln -s /opt/curl-wasm/lib64 /opt/curl-wasm/lib || true

# Clone MuMain repository and submodules
WORKDIR /src
RUN git clone --recursive https://github.com/sven-n/MuMain.git mumain

WORKDIR /src/mumain

# Pre-populate NuGet cache for wire-size codegen (MUnique.OpenMU.Network.Packets v0.9.10)
RUN mkdir -p /src/mumain/.nuget/munique.openmu.network.packets/0.9.10 && \
    wget -qO /tmp/packets.nupkg https://api.nuget.org/v3-flatcontainer/munique.openmu.network.packets/0.9.10/munique.openmu.network.packets.0.9.10.nupkg && \
    python3 -m zipfile -e /tmp/packets.nupkg /src/mumain/.nuget/munique.openmu.network.packets/0.9.10 && \
    rm /tmp/packets.nupkg

# Build script with WASM compilation pointing explicitly to OpenSSL and cURL WASM static libraries
RUN emcmake cmake -B build-wasm \
    -DCMAKE_BUILD_TYPE=Release \
    -DENABLE_EDITOR=OFF \
    -DCMAKE_PREFIX_PATH="/opt/curl-wasm;/opt/openssl-wasm" \
    -DCURL_INCLUDE_DIR=/opt/curl-wasm/include \
    -DCURL_LIBRARY=/opt/curl-wasm/lib/libcurl.a \
    -DOPENSSL_ROOT_DIR=/opt/openssl-wasm \
    -DOPENSSL_INCLUDE_DIR=/opt/openssl-wasm/include \
    -DOPENSSL_CRYPTO_LIBRARY=/opt/openssl-wasm/lib/libcrypto.a \
    -DOPENSSL_USE_STATIC_LIBS=TRUE

RUN cmake --build build-wasm --target Main -j$(nproc)

# Stage 2: Serve WebAssembly assets via NGINX
FROM nginx:alpine

COPY ./nginx/default.conf /etc/nginx/conf.d/default.conf
COPY ./public /usr/share/nginx/html

# Copy compiled WASM and JS glue code
COPY --from=builder /src/mumain/build-wasm/src/Main.js /usr/share/nginx/html/client.js
COPY --from=builder /src/mumain/build-wasm/src/Main.wasm /usr/share/nginx/html/client.wasm

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
